# ===========================================================================
# Casa Numa · Variables de entorno
# ---------------------------------------------------------------------------
# Copia lo de FRONTEND a un archivo .env.local (Vite lo lee solo y .gitignore
# ya lo excluye). Lo de SERVIDOR se carga como secretos de Supabase:
#
#   supabase secrets set --env-file .env.server
#
# Fíjate en la proporción: 4 públicas contra 15 secretas. Todo lo que da poder
# vive del lado del servidor.
#
# NUNCA subas un .env real al repositorio.
# ===========================================================================


# ---------------------------------------------------------------------------
# FRONTEND · van al navegador · se configuran en Vercel
# ---------------------------------------------------------------------------
# El prefijo VITE_ significa "esto es público": Vite incrusta estas variables
# dentro del bundle en tiempo de compilación, así que cualquiera puede leerlas
# abriendo las herramientas de desarrollador. Eso es correcto y esperado — lo
# que protege los datos es el Row Level Security, no el secreto de estas
# llaves.
#
# Úsalo SOLO para lo que de verdad es público.

# Supabase tiene dos generaciones de llaves. Usa la que tenga tu proyecto:
#   NUEVA (Settings -> API Keys -> Publishable key):  sb_publishable_...
#   VIEJA (Settings -> API Keys -> Legacy anon):      eyJhbGciOi...
# El nombre de la variable es el mismo en los dos casos.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_CLOUDINARY_CLOUD_NAME=casa-numa
VITE_APP_URL=https://casanuma.mx


# ---------------------------------------------------------------------------
# SERVIDOR · solo Edge Functions · nunca en el navegador
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Ignora por completo el Row Level Security. Quien la tiene puede leer, cambiar
# y borrar cualquier fila de cualquier tabla. Si llegara al bundle, un
# desconocido podría descargar la lista de clientes con sus teléfonos, poner
# todos los talleres en $1, o borrar las reservaciones.
#
# NUNCA la nombres VITE_SUPABASE_SERVICE_ROLE_KEY.
#
# NUEVA (Settings -> API Keys -> Secret key):        sb_secret_...
# VIEJA (Settings -> API Keys -> Legacy service_role): eyJhbGciOi...
# El codigo acepta cualquiera de los dos nombres de variable.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Stripe ----------------------------------------------------------------
# Empieza con las llaves de prueba (sk_test_ / whsec_). Pasar a producción es
# cambiar estas dos y volver a desplegar.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=https://casanuma.mx/pago/exitoso?code={CODE}
STRIPE_CANCEL_URL=https://casanuma.mx/pago/cancelado

# --- Resend ----------------------------------------------------------------
# El dominio debe estar verificado (SPF y DKIM). Sin eso los correos caen en
# spam o Resend responde 422.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Casa Numa <hola@casanuma.mx>
RESEND_ADMIN_EMAIL=hola@casanuma.mx

# --- Cloudinary ------------------------------------------------------------
# El SECRET nunca sale de la Edge Function: solo se usa para firmar subidas.
CLOUDINARY_CLOUD_NAME=casa-numa
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Calendar -------------------------------------------------------
# Recuerda que el calendario debe estar COMPARTIDO con la cuenta que autorizó
# el refresh token, con permiso para hacer cambios en eventos.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REFRESH_TOKEN=1//0x...
GOOGLE_CALENDAR_ID=xxxxxxxx@group.calendar.google.com
GOOGLE_TIMEZONE=America/Monterrey

# --- Aplicación ------------------------------------------------------------
# Origen permitido para CORS y base de los enlaces en los correos.
APP_URL=https://casanuma.mx

# Duración del hold en minutos. La especificación pide 10; es configurable.
HOLD_MINUTES=10

# Protege el worker que dispara pg_cron. Genera una cadena larga al azar.
CRON_SECRET=cambia-esto-por-algo-largo-y-aleatorio
