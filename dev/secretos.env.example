# ===========================================================================
# Secretos de las Edge Functions
# ---------------------------------------------------------------------------
# Copia este archivo como dev/secretos.env y llena los valores.
# dev/secretos.env está en .gitignore: nunca se sube.
#
# Se cargan con:  node dev/desplegar.mjs
#
# Puedes llenarlo por partes. Lo que dejes con el valor de ejemplo simplemente
# no se carga, y el script te avisa qué funciones quedan sin operar.
# ===========================================================================


# --- Supabase --------------------------------------------------------------
# Ya los conocemos; el único que falta es la Secret key.
SUPABASE_URL=https://xjerknpiyokzzcihwkpg.supabase.co
SUPABASE_ANON_KEY=sb_publishable_YHNS0lzUGRa9SUF1S6NR2g_mdEbYB4O

# Settings -> API Keys -> Secret key (sb_secret_...). Da clic en el ojo para
# verla. IGNORA el RLS por completo: solo va aquí, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...


# --- Aplicación ------------------------------------------------------------
# En local déjalo así. Al desplegar a Vercel, cámbialo por el dominio real.
APP_URL=http://localhost:5173

# Duración del hold en minutos.
HOLD_MINUTES=10

# Protege el worker que dispara pg_cron. Inventa una cadena larga al azar
# (por ejemplo el resultado de: openssl rand -hex 24)
CRON_SECRET=cambia-esto-por-algo-largo-y-aleatorio


# --- Stripe · LO SIGUIENTE QUE HACE FALTA -----------------------------------
# stripe.com -> modo Test -> Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=sk_test_...

# Se obtiene DESPUÉS de crear el webhook (ver README, sección Stripe Webhooks).
# Sin esto los pagos no se confirman nunca.
STRIPE_WEBHOOK_SECRET=whsec_...

STRIPE_SUCCESS_URL=http://localhost:5173/pago/exitoso?code={CODE}
STRIPE_CANCEL_URL=http://localhost:5173/pago/cancelado


# --- Resend · correos (puede esperar) --------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Casa Numa <hola@casanuma.mx>
RESEND_ADMIN_EMAIL=hola@casanuma.mx


# --- Cloudinary · imágenes (puede esperar) ---------------------------------
CLOUDINARY_CLOUD_NAME=casa-numa
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...


# --- Google Calendar (puede esperar) ---------------------------------------
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...
GOOGLE_CALENDAR_ID=...@group.calendar.google.com
GOOGLE_TIMEZONE=America/Monterrey
